# These sources compile together with Iris core and must generate the same members, so this repeats
# ../Iris/lombok.config, which Lombok never reaches from here: it looks upward from each source file.
# Keep the two in sync; ../Iris/lombok.config explains each setting.
config.stopBubbling = true
lombok.equalsAndHashCode.doNotUseGetters = true
lombok.toString.doNotUseGetters = true
