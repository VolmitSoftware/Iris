# Iris compiled these sources itself before they had a build of their own, so this repeats ../Iris/lombok.config to keep
# the members Lombok generates, and with them the classes Iris ships, unchanged. ../Iris/lombok.config explains each setting.
config.stopBubbling = true
lombok.equalsAndHashCode.doNotUseGetters = true
lombok.toString.doNotUseGetters = true
